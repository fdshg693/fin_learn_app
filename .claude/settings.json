{
  "respectGitignore": true,
  "includeGitInstructions": false,
  "permissions": {
    "allow": [
      "Bash(dotnet test:*)",
      "Bash(dotnet build:*)",
      "Bash(npm run typecheck)",
      "Bash(terraform init:*)",
      "Bash(terraform validate:*)",
      "Bash(az appservice list-locations:*)",
      "Bash(az vm list-usage:*)",
      "Bash(az provider show:*)",
      "Bash(az account show:*)",
      "Bash(echo \"exit:$?\")"
    ]
  },
  "disabledMcpjsonServers": [
    "dynamic-prompt"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "agent",
            "prompt": "`update-docs`スキルを使って、今回の変更の関連ドキュメントを更新の状態に保ってください。",
            "timeout": 600,
            "model": "sonnet"
          }
        ]
      }
    ]
  },
  "plansDirectory": "./.claude/plans"
}
